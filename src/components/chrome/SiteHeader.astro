---
import type { Locale } from '../../lib/i18n/locales';
import { localeHref } from '../../lib/i18n/routes';
import { ui } from '../../lib/i18n/ui';
import LocaleSwitcher from './LocaleSwitcher.astro';
import { navigationFor, wordmark } from './navigation';
import Wordmark from './Wordmark.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const strings = ui(locale);
const navigation = navigationFor(locale);
const pathname = Astro.url.pathname;
const homeLabel = `${wordmark.name} · ${strings.chrome.homeSuffix}`;
---

<script is:inline>
  document.documentElement.dataset.headerMenuJs = 'true';
</script>

<header class="site-header">
  <div class="shell-content site-header__inner">
    <a
      class="site-header__wordmark"
      href={localeHref(locale, '/')}
      aria-label={homeLabel}
    >
      <span class="site-header__name" aria-hidden="true">
        <Wordmark spread />
      </span>
      <span class="site-header__edition" aria-hidden="true"
        >{wordmark.edition}</span
      >
    </a>
    <nav class="site-header__nav" aria-label={strings.chrome.primaryMenu}>
      <mobile-navigation>
        <details
          aria-label={strings.chrome.primaryMenu}
          data-disclosure
          data-motion="fast"
          open
        >
          <summary aria-label={strings.chrome.menu}>
            <span class="site-header__menu-icon" aria-hidden="true">
              <span></span>
              <span></span>
            </span>
          </summary>
          <div class="disclosure__panel">
            <ul class="site-header__nav-list">
              {
                navigation.map(({ href, label }) => (
                  <li>
                    <a
                      href={href}
                      aria-current={pathname === href ? 'page' : undefined}
                    >
                      {label}
                    </a>
                  </li>
                ))
              }
            </ul>
            <LocaleSwitcher locale={locale} />
          </div>
        </details>
      </mobile-navigation>
    </nav>
  </div>
</header>

<script src="../../scripts/disclosure.ts"></script>

<style>
  .site-header {
    position: relative;
    z-index: 5;
    border-bottom: 1px solid color-mix(in srgb, var(--ivory) 14%, transparent);
    background: color-mix(in srgb, var(--night) 70%, transparent);
    backdrop-filter: blur(16px);
    view-transition-name: site-header;
  }

  .site-header__inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    min-height: 5.25rem;
  }

  .site-header__wordmark {
    display: grid;
    grid-template-columns: minmax(0, max-content);
    flex: 0 0 auto;
    color: var(--ivory);
    /* Header aliases (BaseLayout preloads them, font-display: block) keep the
       chrome in the same face on every page; see src/lib/fonts. */
    font-family: 'Bebas Neue Header', var(--font-display);
    font-size: clamp(1.75rem, 3vw, 2.4rem);
    letter-spacing: 0.075em;
    line-height: 0.8;
    text-decoration: none;
  }

  .site-header__name {
    display: flex;
    justify-content: space-between;
    /* The edition line sets the lockup width; distribute the name's spacing
       across that measure without stretching the glyphs. */
    inline-size: 0;
    min-inline-size: 100%;
    letter-spacing: 0;
  }

  .site-header__nav,
  .site-header__nav > mobile-navigation {
    min-width: 0;
  }

  .site-header__nav {
    display: flex;
    flex: 1 1 0;
    align-items: center;
    justify-content: flex-end;
    gap: 0.6rem;
  }

  .site-header__nav > mobile-navigation {
    display: block;
    flex: 1 1 auto;
  }

  .site-header__nav details {
    width: 100%;
  }

  /* Hidden by default, revealed only inside the mobile query below. Stating
     it as a default rather than as a `min-width` counterpart keeps the
     hamburger on exactly one axis: a paired query has to be kept in step with
     the mobile breakpoint, and when it was not, 705-896px hid the hamburger
     while the script still collapsed the menu — no way to reach the nav at
     tablet portrait. A default cannot fall out of step, and it leaves no
     fractional gap at the boundary either. */
  .site-header__nav summary {
    display: none;
    list-style: none;
  }

  .site-header__nav summary::-webkit-details-marker {
    display: none;
  }

  .site-header__nav .disclosure__panel {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.6rem;
    width: 100%;
  }

  .site-header__nav .disclosure__panel > .site-header__nav-list {
    flex: 1 1 auto;
  }

  .site-header__edition {
    margin-top: 0.45rem;
    color: var(--amber);
    font-family: 'Noto Sans KR Header', var(--font-body);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.22em;
    white-space: nowrap;
  }

  .site-header__nav-list {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    min-width: 0;
    max-width: 100%;
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .site-header__nav-list a {
    position: relative;
    display: grid;
    place-items: center;
    min-inline-size: 44px;
    min-block-size: 44px;
    padding: 0.45rem 0.65rem;
    color: var(--ink-muted);
    font-family: 'Noto Sans KR Header', var(--font-body);
    font-size: 0.82rem;
    font-weight: 700;
    text-decoration: none;
    transition:
      color var(--motion-fast) var(--ease-cinematic),
      background var(--motion-fast) var(--ease-cinematic);
  }

  .site-header__nav-list a::after {
    position: absolute;
    inset: auto 0.65rem 0.4rem;
    height: 2px;
    background: var(--amber);
    content: '';
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--motion-fast) var(--ease-cinematic);
  }

  .site-header__nav-list a:hover,
  .site-header__nav-list a[aria-current='page'] {
    color: var(--ivory);
  }

  .site-header__nav-list a:hover::after,
  .site-header__nav-list a:focus-visible::after,
  .site-header__nav-list a[aria-current='page']::after {
    transform: scaleX(1);
  }

  /* The hamburger has to appear before the menu wraps, not after. The
     english labels are wider than the korean ones, so the english nav
     folds to a second row at 872px while korean holds to 780px — both
     above the old 44rem (704px) threshold, which left a broken band in
     each locale. 56rem clears the wider of the two with margin. Keep
     this in step with the matchMedia query below. */
  @media (max-width: 56rem) {
    .site-header__inner {
      flex-wrap: wrap;
      gap: 1rem;
      min-height: 4rem;
      padding-block: 0.55rem;
    }

    .site-header__wordmark {
      position: absolute;
      inset-block-start: 50%;
      inset-inline-start: 50%;
      inline-size: max-content;
      min-inline-size: 0;
      max-inline-size: 100%;
      transform: translate(-50%, -50%) scale(0.48);
      transform-origin: center;
    }

    .site-header__nav {
      flex: 0 0 auto;
      margin-inline-start: auto;
    }

    .site-header__nav > mobile-navigation,
    .site-header__nav details {
      width: auto;
    }

    .site-header__nav summary {
      display: grid;
      place-items: center;
      inline-size: 44px;
      min-block-size: 44px;
      padding: 0;
      color: var(--ivory);
      font-family: 'Noto Sans KR Header', var(--font-body);
      font-size: 0;
      font-weight: 700;
      cursor: pointer;
    }

    .site-header__menu-icon {
      position: relative;
      display: block;
      inline-size: 22px;
      block-size: 14px;
    }

    .site-header__menu-icon > span {
      position: absolute;
      inset-inline: 0;
      block-size: 2px;
      border-radius: 999px;
      background: currentColor;
      transition: transform var(--motion-fast) var(--ease-cinematic);
    }

    .site-header__menu-icon > span:first-child {
      inset-block-start: 1px;
    }

    .site-header__menu-icon > span:last-child {
      inset-block-end: 1px;
    }

    .site-header__nav
      details[open]:not([data-closing])
      .site-header__menu-icon
      > span:first-child {
      transform: translateY(5px) rotate(45deg);
    }

    .site-header__nav
      details[open]:not([data-closing])
      .site-header__menu-icon
      > span:last-child {
      transform: translateY(-5px) rotate(-45deg);
    }

    .site-header__nav .disclosure__panel {
      position: absolute;
      z-index: 20;
      inset-block-start: calc(100% + 1px);
      inset-inline: calc(var(--gutter) * -1);
      width: auto;
      padding: 0.35rem 0;
      border-block: 1px solid color-mix(in srgb, var(--ivory) 14%, transparent);
      /* Opaque: the panel covers the page's own text, so anything showing
         through lands behind the menu labels. edition.css restates this with
         the edition surface colour. */
      background: var(--night);
    }

    .site-header__nav-list {
      display: grid;
      gap: 0;
      justify-content: stretch;
      min-width: 0;
      width: 100%;
      padding: 0;
    }

    .site-header__nav-list li {
      width: 100%;
    }

    /* On a phone the panel is a dropdown, so the switcher belongs in it as a
       final row rather than beside the hamburger, where it competed with the
       wordmark for the only line it had. */
    .site-header__nav .disclosure__panel {
      display: grid;
      grid-template-columns: 1fr;
      justify-content: stretch;
      justify-items: stretch;
      gap: 0;
    }

    .site-header__nav details:not([open]) > .disclosure__panel {
      display: none;
    }

    :global(html[data-header-menu-js='true'])
      .site-header__nav
      > mobile-navigation:not([data-ready])
      .disclosure__panel {
      display: none;
    }

    :global(html[data-header-menu-js='true'])
      .site-header__nav
      > mobile-navigation:not([data-ready])
      details[open]
      .site-header__menu-icon
      > span {
      transform: none;
    }

    .site-header__nav-list a {
      width: 100%;
      padding-inline: var(--gutter);
      justify-content: start;
    }

    .site-header__nav-list a::after {
      inset-inline: var(--gutter);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header__menu-icon > span {
      transition-duration: 0.01ms;
    }
  }
</style>

<script>
  class MobileNavigation extends HTMLElement {
    private readonly mobileQuery = window.matchMedia('(max-width: 56rem)');
    private details: HTMLDetailsElement | null = null;

    private synchronizeMenu = () => {
      if (this.details) this.details.open = !this.mobileQuery.matches;
    };

    private closeForNavigation = (event: MouseEvent) => {
      if (!this.mobileQuery.matches || !this.details) return;
      const link = (event.target as Element | null)?.closest('a[href]');
      if (!link || !this.contains(link)) return;

      const panel = this.details.querySelector<HTMLElement>(
        ':scope > .disclosure__panel',
      );
      panel?.getAnimations().forEach((animation) => animation.cancel());
      panel?.style.removeProperty('height');
      panel?.style.removeProperty('overflow');
      if (panel?.getAttribute('style') === '') panel.removeAttribute('style');
      delete this.details.dataset.closing;
      delete this.details.dataset.state;
      this.details.open = false;
    };

    connectedCallback() {
      this.details = this.querySelector('details');
      if (!this.details) return;
      this.mobileQuery.addEventListener('change', this.synchronizeMenu);
      this.addEventListener('click', this.closeForNavigation);
      this.synchronizeMenu();
      this.dataset.ready = 'true';
    }

    disconnectedCallback() {
      this.mobileQuery.removeEventListener('change', this.synchronizeMenu);
      this.removeEventListener('click', this.closeForNavigation);
    }
  }

  if (!customElements.get('mobile-navigation')) {
    customElements.define('mobile-navigation', MobileNavigation);
  }
</script>
